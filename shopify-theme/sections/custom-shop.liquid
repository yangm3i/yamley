<style>
  #shopify-section-{{ section.id }} *, #shopify-section-{{ section.id }} *::before, #shopify-section-{{ section.id }} *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:   #FAF9F7;
    --ink:     #1A1A1A;
    --rose:    #9FB8C3;
    --sage:    #B5C4B1;
    --sand:    #D4C5A9;
    --blush:   #CDE3ED;
    --soft-grey: #C4C4C4;
    --sage-light: #DCE6D9;
    --sage-dark: #A3B89D;
    --font:    'Roboto Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  #shopify-section-{{ section.id }} {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── NAV ── */
  #shopify-section-{{ section.id }} nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 48px;
    background: #FFFFFF;
    border-bottom: 1px solid #DDDDDD;
    transition: border-color 0.3s;
  }

  #shopify-section-{{ section.id }} .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .nav-logo img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .nav-links {
    display: flex;
    gap: 10px;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .nav-links a {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.85;
    padding: 6px 16px;
    background: #FFFFFF;
    border-top: 1.5px solid #FFFFFF;
    border-left: 1.5px solid #FFFFFF;
    border-bottom: 1.5px solid var(--soft-grey);
    border-right: 1.5px solid var(--soft-grey);
    border-radius: 0;
    transition: opacity 0.15s, background 0.15s;
  }
  #shopify-section-{{ section.id }} .nav-links a:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .nav-links a.active {
    opacity: 1;
    background: var(--sage-light);
    border-top: 1.5px solid var(--sage-dark);
    border-left: 1.5px solid var(--sage-dark);
    border-bottom: 1.5px solid #FFFFFF;
    border-right: 1.5px solid #FFFFFF;
  }

  /* ── SECTION SHARED ── */
  #shopify-section-{{ section.id }} section { padding: 96px 48px; }

  #shopify-section-{{ section.id }} .section-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 12px;
  }

  /* ── SHOP ── */
  #shopify-section-{{ section.id }} .shop-page-wrap { padding-top: 80px; }

  #shopify-section-{{ section.id }} .shop-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .shop-title {
    font-family: "pf-pixelscript", serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 400;
    color: #4A4A4A;
    line-height: 1.1;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .shop-panel {
    border: 1.5px solid #33586A;
    border-radius: 10px;
    background: #FFFFFF;
    box-shadow: 4px 4px 0 #9C9C9C;
    padding: 28px 24px 24px;
    width: 100%;
    box-sizing: border-box;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .shop-filters {
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-bottom: 26px;
  }
  #shopify-section-{{ section.id }} .shop-filter {
    font-family: var(--font);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    color: var(--ink);
    opacity: 0.6;
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    text-decoration: none;
    text-underline-offset: 7px;
    text-decoration-thickness: 2px;
  }
  #shopify-section-{{ section.id }} .shop-filter:hover { opacity: 0.9; }
  #shopify-section-{{ section.id }} .shop-filter.active {
    opacity: 1;
    text-decoration-line: underline;
    text-decoration-color: var(--sage-dark);
  }
  #shopify-section-{{ section.id }} .shop-filter-sep { font-size: 12px; opacity: 0.35; }
  #shopify-section-{{ section.id }} .shop-filter-empty {
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.05em;
    opacity: 0.55;
    padding: 32px 0 16px;
  }

  #shopify-section-{{ section.id }} .shop-empty {
    text-align: center;
    padding: 40px 12px 24px;
  }
  #shopify-section-{{ section.id }} .shop-empty h2 {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 200;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .shop-empty p {
    font-size: 14px;
    line-height: 1.9;
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .shop-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    #shopify-section-{{ section.id }} .shop-grid { grid-template-columns: 1fr; }
  }

  #shopify-section-{{ section.id }} .shop-card {
    position: relative;
  }
  #shopify-section-{{ section.id }} .shop-card-link {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .shop-quick-add {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font);
    font-size: 18px;
    line-height: 1;
    color: var(--ink);
    background: #FFFFFF;
    border-top: 1.5px solid #FFFFFF;
    border-left: 1.5px solid #FFFFFF;
    border-bottom: 1.5px solid var(--soft-grey);
    border-right: 1.5px solid var(--soft-grey);
    border-radius: 0;
    cursor: pointer;
    transition: background 0.15s;
  }
  #shopify-section-{{ section.id }} .shop-quick-add:hover { background: var(--sage-light); }
  #shopify-section-{{ section.id }} .shop-quick-add.added { background: var(--sage-light); }
  #shopify-section-{{ section.id }} .shop-quick-add:disabled { cursor: default; }
  #shopify-section-{{ section.id }} .shop-card-media {
    position: relative;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .shop-card-frame {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background: var(--sage-light);
  }
  #shopify-section-{{ section.id }} .shop-card-track {
    display: flex;
    height: 100%;
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} .shop-card-slide {
    flex: 0 0 100%;
    height: 100%;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .shop-card-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} .shop-card-arrow {
    position: absolute;
    bottom: 10px;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #FFFFFF;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.55), 0 1px 6px rgba(0, 0, 0, 0.45);
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .shop-card-arrow.next { right: 10px; }
  #shopify-section-{{ section.id }} .shop-card-media:hover .shop-card-arrow,
  #shopify-section-{{ section.id }} .shop-card-arrow:focus-visible { opacity: 1; }
  @media (hover: none) {
    #shopify-section-{{ section.id }} .shop-card-arrow { opacity: 0.85; }
  }
  #shopify-section-{{ section.id }} .shop-card:hover .shop-card-frame img {
    transform: scale(1.04);
  }
  #shopify-section-{{ section.id }} .shop-card-title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    opacity: 0.85;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .shop-card-price {
    font-size: 11px;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  /* ── FOOTER ── */
  #shopify-section-{{ section.id }} footer {
    background: #FFFFFF;
    color: var(--ink);
    border-top: 1px solid #DDDDDD;
    text-align: center;
    padding: 24px 48px;
    font-size: 10px;
    letter-spacing: 0.15em;
    opacity: 0.4;
  }

  /* ── REVEAL ANIMATION ── */
  #shopify-section-{{ section.id }} .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #shopify-section-{{ section.id }} .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} nav { padding: 16px 12px; }
    #shopify-section-{{ section.id }} .nav-links { gap: 4px; }
    #shopify-section-{{ section.id }} .nav-links a { padding: 6px 8px; letter-spacing: 0.05em; }
    #shopify-section-{{ section.id }} .nav-logo img { width: 36px; height: 36px; }
    #shopify-section-{{ section.id }} section { padding: 64px 20px; }
  }
</style>

<div id="shopify-section-{{ section.id }}">

<nav id="nav-{{ section.id }}">
  <a class="nav-logo" href="{{ pages.home.url | default: '/pages/home' }}">
    <img src="{{ 'icons--yam-flower---cropped.png' | asset_url }}" style="opacity:1;" alt="yam logo" />
  </a>
  <ul class="nav-links">
    <li><a href="{{ pages.home.url | default: '/pages/home' }}">Home</a></li>
    <li><a href="/collections/all" class="active">Shop</a></li>
    <li><a href="{{ pages.work.url | default: '/pages/work' }}">Work</a></li>
    <li><a href="{{ pages.about.url | default: '/pages/about' }}">About</a></li>
    <li><a href="{{ routes.cart_url }}" aria-label="Cart"><img src="{{ 'nav-cart-pixel.png' | asset_url }}" alt="" width="18" height="14" style="height:14px; width:auto; vertical-align:-2px; image-rendering:pixelated; margin-right:6px;"><span class="nav-cart-count">{{ cart.item_count }}</span></a></li>
  </ul>
</nav>

<div class="shop-page-wrap">
  <section id="shop-{{ section.id }}">
    <div class="shop-inner reveal">
      <h1 class="shop-title">product collection</h1>
      <div class="shop-panel">

        {% if collection.products.size > 0 %}
          <div class="shop-filters" role="tablist" aria-label="Product categories">
            <button type="button" class="shop-filter active" data-filter="all" role="tab" aria-selected="true">all</button>
            <span class="shop-filter-sep" aria-hidden="true">|</span>
            <button type="button" class="shop-filter" data-filter="photo-book" role="tab" aria-selected="false">photo book</button>
            <span class="shop-filter-sep" aria-hidden="true">|</span>
            <button type="button" class="shop-filter" data-filter="clay-objects" role="tab" aria-selected="false">clay objects</button>
          </div>
          <div class="shop-grid">
            {% for product in collection.products %}
              {%- capture product_cats -%}
                {{ product.type | handleize }}{% for tag in product.tags %} {{ tag | handleize }}{% endfor %}
              {%- endcapture -%}
              <div class="shop-card" data-cats="{{ product_cats | strip }}">
                <div class="shop-card-media">
                  <a class="shop-card-frame" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                    <div class="shop-card-track">
                      {% for image in product.images %}
                        <div class="shop-card-slide">
                          <img src="{{ image | image_url: width: 600 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">
                        </div>
                      {% endfor %}
                    </div>
                  </a>
                  {% if product.images.size > 1 %}
                    <button type="button" class="shop-card-arrow next" aria-label="Next photo of {{ product.title | escape }}">&#8594;</button>
                  {% endif %}
                  {% if product.available %}
                    <button type="button" class="shop-quick-add" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Add {{ product.title | escape }} to cart">+</button>
                  {% endif %}
                </div>
                <a class="shop-card-link" href="{{ product.url }}">
                  <div class="shop-card-title">{{ product.title | downcase }}</div>
                  <div class="shop-card-price">{{ product.price | money }}</div>
                </a>
              </div>
            {% endfor %}
          </div>
          <p class="shop-filter-empty" hidden>nothing here yet &mdash; check back soon.</p>
        {% else %}
          <div class="shop-empty">
            <h2>products coming soon</h2>
            <p>check back soon for ceramics, prints, and other handmade things.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </section>
</div>

<footer>
  <img src="{{ 'logo-ink.png' | asset_url }}" alt="yam logo" style="height:14px; width:auto; vertical-align:middle; margin-right:6px; opacity:0.75;" />yamley &nbsp;·&nbsp; digital media scrapbook
</footer>

</div>

<script>
(function () {
  var nav = document.getElementById('nav-{{ section.id }}');
  window.addEventListener('scroll', function () {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  var observer = new IntersectionObserver(
    function (entries) { entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('visible'); }); },
    { threshold: 0.12 }
  );
  document.querySelectorAll('#shopify-section-{{ section.id }} .reveal').forEach(function (el) { observer.observe(el); });

  var root = document.getElementById('shopify-section-{{ section.id }}');

  root.querySelectorAll('.shop-card-media').forEach(function (media) {
    var track = media.querySelector('.shop-card-track');
    var count = track.children.length;
    var idx = 0;
    function go(step) {
      idx = (idx + step + count) % count;
      track.style.transform = 'translateX(' + (-idx * 100) + '%)';
    }
    if (count > 1) {
      media.addEventListener('pointerenter', function () {
        track.querySelectorAll('img').forEach(function (img) { img.loading = 'eager'; });
      }, { once: true });
    }
    media.querySelectorAll('.shop-card-arrow').forEach(function (btn) {
      btn.addEventListener('click', function () { go(1); });
    });
  });
  var filters = root.querySelectorAll('.shop-filter');
  var cards = root.querySelectorAll('.shop-card');
  var filterEmpty = root.querySelector('.shop-filter-empty');
  filters.forEach(function (f) {
    f.addEventListener('click', function () {
      var cat = f.dataset.filter;
      filters.forEach(function (o) {
        o.classList.toggle('active', o === f);
        o.setAttribute('aria-selected', o === f ? 'true' : 'false');
      });
      var shown = 0;
      cards.forEach(function (card) {
        var match = cat === 'all' || (' ' + card.dataset.cats + ' ').indexOf(' ' + cat + ' ') !== -1;
        card.hidden = !match;
        if (match) shown++;
      });
      if (filterEmpty) filterEmpty.hidden = shown > 0;
    });
  });

  document.querySelectorAll('#shopify-section-{{ section.id }} .shop-quick-add').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(btn.dataset.variantId), quantity: 1 }] })
      })
        .then(function (res) {
          if (!res.ok) throw new Error();
          btn.textContent = '✓';
          btn.classList.add('added');
          return fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            document.querySelectorAll('.nav-cart-count').forEach(function (el) { el.textContent = cart.item_count; });
          });
        })
        .catch(function () { btn.textContent = '!'; })
        .finally(function () {
          setTimeout(function () { btn.textContent = '+'; btn.classList.remove('added'); btn.disabled = false; }, 1500);
        });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Custom shop",
  "settings": []
}
{% endschema %}
