<style>
  #shopify-section-{{ section.id }} *, #shopify-section-{{ section.id }} *::before, #shopify-section-{{ section.id }} *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:      #FAF9F7;
    --ivory-soft: #FFFDF6;
    --ink:     #1A1A1A;
    --rose:    #9FB8C3;
    --sage:    #B5C4B1;
    --sand:    #D4C5A9;
    --blush:   #CDE3ED;
    --soft-grey: #C4C4C4;
    --sage-light: #DCE6D9;
    --sage-dark: #A3B89D;
    --font:    'Roboto Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  #shopify-section-{{ section.id }} {
    background: radial-gradient(ellipse 70% 55% at 50% 45%, var(--ivory-soft) 0%, var(--cream) 70%);
    background-attachment: fixed;
    color: var(--ink);
    font-family: var(--font);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── NAV ── */
  #shopify-section-{{ section.id }} nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 48px;
    background: #FFFFFF;
    border-bottom: 1px solid #DDDDDD;
    transition: border-color 0.3s;
  }

  #shopify-section-{{ section.id }} .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .nav-logo img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .nav-logo span {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .nav-links {
    display: flex;
    gap: 10px;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .nav-links a {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.85;
    padding: 6px 16px;
    background: #FFFFFF;
    border-top: 1.5px solid #FFFFFF;
    border-left: 1.5px solid #FFFFFF;
    border-bottom: 1.5px solid var(--soft-grey);
    border-right: 1.5px solid var(--soft-grey);
    border-radius: 8px;
    transition: opacity 0.15s, background 0.15s;
  }
  #shopify-section-{{ section.id }} .nav-links a:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .nav-links a.active {
    opacity: 1;
    background: var(--sage-light);
    border-top: 1.5px solid var(--sage-dark);
    border-left: 1.5px solid var(--sage-dark);
    border-bottom: 1.5px solid #FFFFFF;
    border-right: 1.5px solid #FFFFFF;
  }

  /* ── HERO ── */
  #shopify-section-{{ section.id }} .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 80px;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-bg-circle {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hero-bg-circle.a {
    width: 420px; height: 420px;
    background: var(--blush);
    top: 10%; left: -80px;
    opacity: 0.25;
    filter: blur(60px);
  }
  #shopify-section-{{ section.id }} .hero-bg-circle.b {
    width: 340px; height: 340px;
    background: var(--sage);
    bottom: 5%; right: -60px;
    opacity: 0.18;
    filter: blur(50px);
  }

  #shopify-section-{{ section.id }} .hero-logo {
    width: 190px;
    height: 190px;
    object-fit: contain;
    margin-bottom: 32px;
    opacity: 1;
    animation: homeFloatLogo 6s ease-in-out infinite;
  }
  @keyframes homeFloatLogo {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  #shopify-section-{{ section.id }} .hero p {
    font-size: 14px;
    letter-spacing: 0.12em;
    opacity: 0.5;
    text-transform: lowercase;
    margin-bottom: 48px;
  }

  #shopify-section-{{ section.id }} .hero-subheader {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .hero-subheader-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .hero-subheader .handle {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ink);
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .hero-subheader a {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s;
  }
  #shopify-section-{{ section.id }} .hero-subheader a:hover { color: var(--sage); }
  #shopify-section-{{ section.id }} .hero-subheader .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.5;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .hero-subheader .tagline {
    font-size: 16px;
    letter-spacing: 0.06em;
    color: #555555;
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .hero-ascii {
    font-family: monospace;
    font-weight: 400;
    font-size: 11px;
    line-height: 1.2;
    color: var(--ink);
    white-space: pre;
    margin-bottom: 32px;
    opacity: 0.7;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .scroll-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.3;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: homeScrollFade 3s ease-in-out infinite;
  }
  #shopify-section-{{ section.id }} .scroll-hint pre {
    font-family: monospace;
    font-weight: 400;
    font-size: 5px;
    line-height: 1.1;
    color: var(--ink);
    white-space: pre;
    margin: 0;
  }
  @keyframes homeScrollFade {
    0%, 100% { opacity: 0.2; transform: translateX(-50%) translateY(0); }
    50%       { opacity: 0.45; transform: translateX(-50%) translateY(4px); }
  }

  /* ── SECTION SHARED ── */
  #shopify-section-{{ section.id }} section { padding: 96px 48px; }

  #shopify-section-{{ section.id }} .section-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 12px;
  }

  /* ── CONTACT ── */
  #shopify-section-{{ section.id }} .contact {
    background: transparent;
    color: var(--ink);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .contact .section-label { color: var(--rose); opacity: 1; }
  #shopify-section-{{ section.id }} .contact h2 {
    font-size: clamp(15px, 2vw, 24px);
    font-weight: 300;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    color: #555555;
  }
  #shopify-section-{{ section.id }} .contact p {
    font-size: 14px;
    opacity: 0.6;
    margin-bottom: 40px;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }
  #shopify-section-{{ section.id }} .socials a {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: lowercase;
    color: var(--ink);
    text-decoration: none;
    padding: 12px 24px;
    background: #FFFFFF;
    border-top: 2px solid #FFFFFF;
    border-left: 2px solid #FFFFFF;
    border-bottom: 2px solid var(--sage);
    border-right: 2px solid var(--sage);
    border-radius: 8px;
    transition: background 0.15s, border-color 0.15s;
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .socials a:hover {
    background: #E5EAE4;
    border-top: 2px solid var(--sage);
    border-left: 2px solid var(--sage);
    border-bottom: 2px solid #FFFFFF;
    border-right: 2px solid #FFFFFF;
    color: var(--ink);
    opacity: 1;
  }

  /* ── FOOTER ── */
  #shopify-section-{{ section.id }} footer {
    background: #FFFFFF;
    color: var(--ink);
    border-top: 1px solid #DDDDDD;
    text-align: center;
    padding: 24px 48px;
    font-size: 10px;
    letter-spacing: 0.15em;
    opacity: 0.4;
  }

  /* ── REVEAL ANIMATION ── */
  #shopify-section-{{ section.id }} .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #shopify-section-{{ section.id }} .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} nav { padding: 16px 20px; }
    #shopify-section-{{ section.id }} .nav-links { gap: 20px; }
    #shopify-section-{{ section.id }} section { padding: 64px 20px; }
    #shopify-section-{{ section.id }} .hero { padding: 100px 20px 60px; }

    #shopify-section-{{ section.id }} .hero-wings-row {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .hero-wings-row .hero-ascii {
      display: flex;
      flex-direction: row;
      gap: 24px;
    }
    #shopify-section-{{ section.id }} .hero-wings-row img {
      width: 100% !important;
      max-width: 340px;
      flex: 0 0 auto !important;
      height: auto !important;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
  }
</style>

