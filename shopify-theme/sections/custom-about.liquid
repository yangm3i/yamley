<style>
  #shopify-section-{{ section.id }} *, #shopify-section-{{ section.id }} *::before, #shopify-section-{{ section.id }} *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:   #FAF9F7;
    --ink:     #1A1A1A;
    --rose:    #9FB8C3;
    --sage:    #B5C4B1;
    --sand:    #D4C5A9;
    --blush:   #CDE3ED;
    --soft-grey: #C4C4C4;
    --sage-light: #DCE6D9;
    --sage-dark: #A3B89D;
    --font:    'Roboto Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  #shopify-section-{{ section.id }} {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── NAV ── */
  #shopify-section-{{ section.id }} nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 48px;
    background: #FFFFFF;
    border-bottom: 1px solid #DDDDDD;
    transition: border-color 0.3s;
  }

  #shopify-section-{{ section.id }} .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .nav-logo img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .nav-links {
    display: flex;
    gap: 10px;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .nav-links a {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.85;
    padding: 6px 16px;
    background: #FFFFFF;
    border-top: 1.5px solid #FFFFFF;
    border-left: 1.5px solid #FFFFFF;
    border-bottom: 1.5px solid var(--soft-grey);
    border-right: 1.5px solid var(--soft-grey);
    border-radius: 0;
    transition: opacity 0.15s, background 0.15s;
  }
  #shopify-section-{{ section.id }} .nav-links a:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .nav-links a.active {
    opacity: 1;
    background: var(--sage-light);
    border-top: 1.5px solid var(--sage-dark);
    border-left: 1.5px solid var(--sage-dark);
    border-bottom: 1.5px solid #FFFFFF;
    border-right: 1.5px solid #FFFFFF;
  }

  /* ── SECTION SHARED ── */
  #shopify-section-{{ section.id }} section { padding: 96px 48px; }

  #shopify-section-{{ section.id }} .section-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 12px;
  }

  /* ── ABOUT ── */
  #shopify-section-{{ section.id }} .about-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .about-searchbar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 320px;
    max-width: 100%;
    margin: 0 auto 28px;
    padding: 16px 26px;
    background: #EFEFEF;
    border: 1px solid var(--soft-grey);
    border-radius: 999px;
    color: #777777;
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }
  #shopify-section-{{ section.id }} .about-searchbar svg { flex-shrink: 0; opacity: 0.7; width: 18px; height: 18px; }

  #shopify-section-{{ section.id }} .about-img-wrap {
    position: relative;
    width: 340px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .about-img-wrap .portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    min-height: 260px;
    background: var(--sage);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .about-img-wrap .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .about-text h2 {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .about-text h2 strong {
    font-weight: 400;
    color: var(--rose);
  }
  #shopify-section-{{ section.id }} .about-text p {
    font-size: 14px;
    line-height: 1.9;
    opacity: 0.65;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .about-star-icon {
    display: block;
    width: 120px;
    margin: 0 auto 24px;
    opacity: 0.85;
    animation: aboutFloatLogo 6s ease-in-out infinite;
  }
  @keyframes aboutFloatLogo {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  /* ── CONTACT ── */
  #shopify-section-{{ section.id }} .contact {
    background: var(--cream);
    color: var(--ink);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .contact .section-label { color: var(--rose); opacity: 1; }
  #shopify-section-{{ section.id }} .contact h2 {
    font-size: clamp(15px, 2vw, 24px);
    font-weight: 300;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    color: #555555;
  }
  #shopify-section-{{ section.id }} .contact p {
    font-size: 14px;
    opacity: 0.6;
    margin-bottom: 40px;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  #shopify-section-{{ section.id }} .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }
  #shopify-section-{{ section.id }} .socials a {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: lowercase;
    color: var(--ink);
    text-decoration: none;
    padding: 12px 24px;
    background: #FFFFFF;
    border-top: 2px solid #FFFFFF;
    border-left: 2px solid #FFFFFF;
    border-bottom: 2px solid var(--sage);
    border-right: 2px solid var(--sage);
    border-radius: 0;
    transition: background 0.15s, border-color 0.15s;
    opacity: 0.9;
  }
  #shopify-section-{{ section.id }} .socials a:hover {
    background: #E5EAE4;
    border-top: 2px solid var(--sage);
    border-left: 2px solid var(--sage);
    border-bottom: 2px solid #FFFFFF;
    border-right: 2px solid #FFFFFF;
    color: var(--ink);
    opacity: 1;
  }

  /* ── FOOTER ── */
  #shopify-section-{{ section.id }} footer {
    background: #FFFFFF;
    color: var(--ink);
    border-top: 1px solid #DDDDDD;
    text-align: center;
    padding: 24px 48px;
    font-size: 10px;
    letter-spacing: 0.15em;
    opacity: 0.4;
  }

  /* ── REVEAL ANIMATION ── */
  #shopify-section-{{ section.id }} .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #shopify-section-{{ section.id }} .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .about-page-wrap { padding-top: 80px; }
  #shopify-section-{{ section.id }} .about-sec { padding-bottom: 32px; }
  #shopify-section-{{ section.id }} .contact-sec { padding-top: 32px; }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} nav { padding: 16px 12px; }
    #shopify-section-{{ section.id }} .nav-links { gap: 4px; }
    #shopify-section-{{ section.id }} .nav-links a { padding: 6px 8px; letter-spacing: 0.05em; }
    #shopify-section-{{ section.id }} .nav-logo img { width: 36px; height: 36px; }
    #shopify-section-{{ section.id }} section { padding: 64px 20px; }
    #shopify-section-{{ section.id }} .about-inner { gap: 32px; }
    #shopify-section-{{ section.id }} .about-img-wrap { width: 200px; }
  }
</style>

<div id="shopify-section-{{ section.id }}">

<nav id="nav-{{ section.id }}">
  <a class="nav-logo" href="{{ pages.home.url | default: '/pages/home' }}">
    <img src="{{ 'icons--yam-flower---cropped.png' | asset_url }}" style="opacity:1;" alt="yam logo" />
  </a>
  <ul class="nav-links">
    <li><a href="{{ pages.home.url | default: '/pages/home' }}">Home</a></li>
    <li><a href="/collections/all">Shop</a></li>
    <li><a href="{{ pages.work.url | default: '/pages/work' }}">Work</a></li>
    <li><a href="{{ pages.about.url | default: '/pages/about' }}" class="active">About</a></li>
    <li><a href="{{ routes.cart_url }}">Cart (<span class="nav-cart-count">{{ cart.item_count }}</span>)</a></li>
  </ul>
</nav>

<div class="about-page-wrap">
  <section id="about-{{ section.id }}" class="about-sec">
  <div class="about-inner reveal">
    <div class="about-text" style="border: 1.5px solid #33586A; border-radius: 10px; background: #FFFFFF; box-shadow: 4px 4px 0 #9C9C9C; padding: 28px 24px 24px; box-sizing: border-box; max-width: 700px; margin: 0 auto;">
      <div class="about-searchbar">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        about me
      </div>
      <div class="about-img-wrap" style="margin-bottom: 24px;">
        <div class="portrait">
          <img src="{{ 'icons--nice-to-meet-you.png' | asset_url }}" alt="Hand-drawn illustration of a girl waving with a speech bubble that reads nice to meet you" />
        </div>
      </div>
      <p>
        Hello! My name is Ashley — welcome to my photography and ceramics portfolio.
        I'm a girl in tech who enjoys pursuing my artistic hobbies in my spare time,
        and creating beautiful visual online spaces.
      </p>
      <p>
        Photography, ceramics, and visual art are mediums that help me to slow down,
        practice mindfulness, and focus on small details that are otherwise overlooked.
      </p>
      <p>
        This digital media gallery is intended to be a whimsical curation of beautiful
        objects, moments, and visual artifacts of life the way that I experience it.
        I hope that through sharing my personal experiences I can inspire other people
        to slow down and find beauty in mundane life too :)
      </p>
    </div>
  </div>
</section>
</div>

<!-- CONTACT -->
<section id="contact-{{ section.id }}" class="contact contact-sec reveal">
  <img src="{{ 'icons--untitled_artwork-1.png' | asset_url }}" alt="hand-drawn star with swirl doodle" class="about-star-icon" />
  <h2>thanks for stopping by! feel free to send me a msg</h2>
  <div class="socials">
    <a href="https://www.instagram.com/moments_inmyhead/" target="_blank" rel="noopener">moments_inmyhead</a>
    <a href="https://www.instagram.com/yamley_ceramics/" target="_blank" rel="noopener">yamley_ceramics</a>
  </div>
</section>

<footer>
  <img src="{{ 'logo-ink.png' | asset_url }}" alt="yam logo" style="height:14px; width:auto; vertical-align:middle; margin-right:6px; opacity:0.75;" />yamley &nbsp;·&nbsp; digital media scrapbook
</footer>

</div>

<script>
(function () {
  var nav = document.getElementById('nav-{{ section.id }}');
  window.addEventListener('scroll', function () {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  var observer = new IntersectionObserver(
    function (entries) { entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('visible'); }); },
    { threshold: 0.12 }
  );
  document.querySelectorAll('#shopify-section-{{ section.id }} .reveal').forEach(function (el) { observer.observe(el); });
})();
</script>

