  // ────────────────────────────────────────────────────────────

  function renderPhotos(loc) {
    var grid = root.querySelector('#photo-grid-{{ section.id }}');
    grid.innerHTML = photos
      .filter(function (p) { return p.location === loc; })
      .map(function (p) {
        return '<div class="grid-item" data-location="' + p.location + '">' +
          '<div class="photo-frame">' +
          '<img class="swatch" src="' + p.src + '" alt="' + p.caption + '" />' +
          '<div class="photo-desc">' + p.desc + '</div>' +
          '</div></div>';
      })
      .join('');
  }

  renderPhotos('singapore');

  var nav = document.getElementById('nav-{{ section.id }}');
  window.addEventListener('scroll', function () {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  root.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      root.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
      root.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab + '-{{ section.id }}').classList.add('active');
    });
  });

  root.querySelectorAll('.loc-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      root.querySelectorAll('.loc-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      renderPhotos(btn.dataset.loc);
    });
  });

  // ── CERAMICS DATA ───────────────────────────────────────────
  var ceramics = [
    {
      caption: "yamley ceramics - maker's mark on clay",
      desc: "",
      images: ["{{ 'ceramics--img_9079.jpeg' | asset_url }}"]
    },
    {
      caption: "rice bowl - ocean wave glaze",
      desc: "",
      images: [
        "{{ 'ceramics--img_0698.jpeg' | asset_url }}",
        "{{ 'ceramics--img_0695.jpeg' | asset_url }}",
        "{{ 'ceramics--img_0697.jpeg' | asset_url }}",
        "{{ 'ceramics--img_0713.jpeg' | asset_url }}"
      ]
    },
    {
      caption: "snoopy trinket dish",
      desc: "",
      images: [
        "{{ 'ceramics--img_5882.jpeg' | asset_url }}",
        "{{ 'ceramics--snoopy-dish.png' | asset_url }}"
      ]
    },
    {
      caption: "hand painted bunny teapot",
      desc: "",
      images: [
        "{{ 'ceramics--img_7050.jpeg' | asset_url }}",
        "{{ 'ceramics--img_7049.jpeg' | asset_url }}",
        "{{ 'ceramics--img_7056.jpeg' | asset_url }}",
        "{{ 'ceramics--img_7062.jpeg' | asset_url }}",
        "{{ 'ceramics--img_7058.jpeg' | asset_url }}"
      ]
    },
    {
      caption: "hand painted flower bowl",
      desc: "",
      images: [
        "{{ 'ceramics--scrl_0002.jpg' | asset_url }}",
        "{{ 'ceramics--img_0091.jpeg' | asset_url }}"
      ]
    },
    {
      caption: "small bubble trinket dish - ocean pebble",
      desc: "",
      images: [
        "{{ 'ceramics--img_0074.jpeg' | asset_url }}",
        "{{ 'ceramics--img_0094.jpeg' | asset_url }}",
        "{{ 'ceramics--img_0095.jpeg' | asset_url }}"
      ]
    }
  ];
  // ────────────────────────────────────────────────────────────

  function renderCeramics() {
    var grid = root.querySelector('#ceramics-grid-{{ section.id }}');
    grid.innerHTML = ceramics.map(function (piece, pi) {
      var imgs = piece.images.map(function (src) {
        return '<img src="' + src + '" alt="' + piece.caption + '" />';
      }).join('');
      var dots = '<div class="carousel-dots' + (piece.images.length > 1 ? '' : ' carousel-dots--spacer') + '">' +
        piece.images.map(function (_, i) {
          return '<button class="carousel-dot' + (i === 0 ? ' active' : '') + '" data-piece="' + pi + '" data-i="' + i + '"></button>';
        }).join('') + '</div>';
      var btns = piece.images.length > 1
        ? '<button class="carousel-btn prev" data-piece="' + pi + '">&#8592;</button>' +
          '<button class="carousel-btn next" data-piece="' + pi + '">&#8594;</button>'
        : '';
      return '<div class="grid-item">' +
        '<div class="carousel" id="carousel-{{ section.id }}-' + pi + '">' +
        '<div class="carousel-track">' + imgs + '</div>' +
        btns +
        '</div>' +
        dots +
        '<p class="caption">' + piece.caption + '</p>' +
        (piece.desc ? '<div class="photo-desc">' + piece.desc + '</div>' : '') +
        '</div>';
    }).join('');

    var state = ceramics.map(function () { return { idx: 0 }; });

    function goTo(pi, idx) {
      var track = root.querySelector('#carousel-{{ section.id }}-' + pi + ' .carousel-track');
      track.style.transform = 'translateX(-' + (idx * 100) + '%)';
      state[pi].idx = idx;
      root.querySelectorAll('.carousel-dot[data-piece="' + pi + '"]').forEach(function (d) {
        d.classList.toggle('active', +d.dataset.i === idx);
      });
    }

    root.querySelectorAll('.carousel-btn.prev').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pi = +btn.dataset.piece;
        goTo(pi, Math.max(0, state[pi].idx - 1));
      });
    });
    root.querySelectorAll('.carousel-btn.next').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pi = +btn.dataset.piece;
        goTo(pi, Math.min(ceramics[pi].images.length - 1, state[pi].idx + 1));
      });
    });
    root.querySelectorAll('.carousel-dot').forEach(function (dot) {
      dot.addEventListener('click', function () { goTo(+dot.dataset.piece, +dot.dataset.i); });
    });
  }

  renderCeramics();

  var observer = new IntersectionObserver(
    function (entries) { entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('visible'); }); },
    { threshold: 0.12 }
  );
  root.querySelectorAll('.reveal').forEach(function (el) { observer.observe(el); });
})();
</script>

